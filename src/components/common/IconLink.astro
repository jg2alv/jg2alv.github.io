---
import type { SocialIcon } from '../../data/site';

interface Props {
  href: string;
  label: string;
  icon: SocialIcon;
  tooltipId: string;
  newTab?: boolean;
}

const { href, label, icon, tooltipId, newTab = true } = Astro.props;
const isWebLink = /^https?:/.test(href);
---

<span class="icon-link-wrap">
  <a
    class="icon-link"
    href={href}
    aria-label={label}
    aria-describedby={tooltipId}
    target={newTab ? '_blank' : undefined}
    rel={newTab && isWebLink ? 'noreferrer' : undefined}
  >
    {
      icon === 'github' && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.39.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
          />
        </svg>
      )
    }
    {
      icon === 'linkedin' && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M5.34 7.72A2.18 2.18 0 1 0 5.32 3.36a2.18 2.18 0 0 0 .02 4.36ZM3.48 20.64h3.7V9.55h-3.7v11.09Zm5.75 0h3.7v-6.19c0-1.63.31-3.21 2.33-3.21 1.99 0 2.01 1.86 2.01 3.32v6.08h3.7v-6.85c0-3.36-.73-5.95-4.66-5.95-1.88 0-3.15 1.03-3.67 2.01h-.05v-1.7H9.23v12.49Z"
          />
        </svg>
      )
    }
    {
      icon === 'lattes' && (
        <svg viewBox="0 0 448 512" aria-hidden="true">
          <path
            fill="currentColor"
            d="M97.872 434.733C51.534 339.784 23.966 282.444 23.966 281.02c0-2.322 2.831-2 30.672 3.46 48.965 9.614 75.126 12.326 118.735 12.343 57.697.016 104.681-9.122 141.185-27.484 19.312-9.715 30.925-18.328 40.437-29.994 11.716-14.378 15.48-24.28 15.615-40.946.119-15.852-2.018-24.212-11.19-43.609-3.629-7.664-6.817-16.463-7.121-19.55-.475-4.968-.068-5.68 3.594-6.103 8.003-.948 47.508 37.403 62.055 60.241 25.076 39.386 27.112 81.994 5.884 123.195-13.039 25.313-27.45 42.827-51.577 62.734-40.098 33.062-86.707 56.086-151.068 74.635C186.616 459.911 130.715 472 119.202 472c-2.44 0-7.02-8.003-21.296-37.283l-.034.016ZM110.776 281.612c-45.016-5.832-82.79-10.903-83.96-11.275-2-.644-9.155-24.516-13.191-43.947-1.017-4.917-2.509-17.939-3.323-28.958-3.63-49.17 7.069-83.165 35.739-113.735C94.584 31.985 198.517 25.694 315.778 67.37c20.583 7.324 28.755 12.411 24.975 15.58-2.797 2.34-21.753 2.306-54.509-.102-51.205-3.764-90.184 3.357-110.275 20.176-30.588 25.602-25.924 81.724 13.53 162.682 4.274 8.766 8.579 17.345 9.563 19.091 2.29 4.018.628 7.749-3.357 7.562-1.698-.082-39.915-4.912-84.93-10.746Zm151.016-44.047c-35.928-6.46-68.227-28.739-78.654-54.222-5.002-12.241-4.765-28.213.576-37.774 4.832-8.648 17.31-18.65 28.484-22.839 18.6-6.968 51.17-4.188 74.907 6.41 22.532 10.055 42.507 27.738 49.932 44.185 9.529 21.108 1.593 44.659-18.821 55.9-13.531 7.443-39.827 11.326-56.443 8.342h.019Z"
          />
        </svg>
      )
    }
    {
      icon === 'orcid' && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z"
          />
        </svg>
      )
    }
    {
      icon === 'contact' && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3.5 6.5h17v12h-17z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
          <path d="m4.3 7.4 7.7 6 7.7-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
        </svg>
      )
    }
  </a>
  <span class="icon-tooltip" id={tooltipId} role="tooltip">{label}</span>
</span>

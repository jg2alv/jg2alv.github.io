---
interface Props {
  country: 'br' | 'us' | 'es';
}

const { country } = Astro.props;
const clipId = `language-flag-${country}`;
---

<svg class="language-flag" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <defs><clipPath id={clipId}><circle cx="16" cy="16" r="16" /></clipPath></defs>
  <g clip-path={`url(#${clipId})`}>
    {country === 'br' && <>
      <path fill="#009739" d="M0 0h32v32H0z" />
      <path fill="#ffdf00" d="m16 4 14 12-14 12L2 16Z" />
      <circle cx="16" cy="16" r="6.8" fill="#002776" />
      <path d="M9.6 13.7a16 16 0 0 1 12.8 4.1" fill="none" stroke="#fff" stroke-width="1.4" />
      <g fill="#fff"><circle cx="13" cy="18" r=".45" /><circle cx="16" cy="20" r=".4" /><circle cx="18.4" cy="17.7" r=".35" /><circle cx="16.5" cy="15.7" r=".3" /></g>
    </>}
    {country === 'us' && <>
      <path fill="#fff" d="M0 0h32v32H0z" />
      {Array.from({length: 7}, (_, index) => <path fill="#b22234" d={`M0 ${index * 64 / 13}h32v${32 / 13}H0z`} />)}
      <path fill="#3c3b6e" d="M0 0h17v17.25H0z" />
      {Array.from({length: 5}, (_, row) => Array.from({length: 4}, (_, col) => <path fill="#fff" d="m0-.85.25.58.63.06-.48.42.14.63L0 .51l-.54.33.14-.63-.48-.42.63-.06Z" transform={`translate(${2 + col * 4 + (row % 2) * .5} ${1.8 + row * 3.15})`} />))}
    </>}
    {country === 'es' && <>
      <path fill="#aa151b" d="M0 0h32v32H0z" />
      <path fill="#f1bf00" d="M0 8h32v16H0z" />
      <path fill="#aa151b" d="M9 13h5v5a2.5 2.5 0 0 1-5 0Z" />
      <path fill="#fff" d="M9.8 14h1.7v3.6H9.8z" />
      <path fill="#f1bf00" d="M11.5 14h1.7v3.6h-1.7zM9 11.4l1.3.8 1.2-1.1 1.2 1.1 1.3-.8v1.4H9z" />
      <path fill="#fff" d="M7 13h1v6H7zM15 13h1v6h-1z" />
    </>}
  </g>
</svg>

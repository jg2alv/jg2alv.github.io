---
import { withBase } from '../../utils/paths';
import ThemeToggle from '../common/ThemeToggle.astro';
import LanguageFlag from '../common/LanguageFlag.astro';

interface Props {
  active?: 'home' | 'projects';
}

const { active } = Astro.props;
const sections = [
  { id: 'home', label: 'Home', labelPt: 'Início', labelEs: 'Inicio', icon: 'm3 10 9-7 9 7M5 8.5V21h5v-7h4v7h5V8.5' },
  { id: 'about', label: 'About', labelPt: 'Sobre', labelEs: 'Sobre mí', icon: 'M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM4 21v-2a8 8 0 0 1 16 0v2' },
  { id: 'projects', label: 'Projects', labelPt: 'Projetos', labelEs: 'Proyectos', icon: 'm7 7-5 5 5 5m10-10 5 5-5 5M14 4l-4 16' },
  { id: 'skills', label: 'Skills', labelPt: 'Habilidades', labelEs: 'Habilidades', icon: 'M9.8 2h4.4l.6 2.6 2.2 1.3 2.5-.8 2.2 3.8-1.9 1.8v2.6l1.9 1.8-2.2 3.8-2.5-.8-2.2 1.3-.6 2.6H9.8l-.6-2.6L7 18.1l-2.5.8-2.2-3.8 1.9-1.8v-2.6L2.3 8.9l2.2-3.8 2.5.8 2.2-1.3.6-2.6Zm5.7 10a3.5 3.5 0 1 0-7 0 3.5 3.5 0 0 0 7 0Z' },
  { id: 'publications', label: 'Publications', labelPt: 'Publicações', labelEs: 'Publicaciones', icon: 'M12 5C9 3 5 3 2 4v15c3-1 7-1 10 1m0-15c3-2 7-2 10-1v15c-3-1-7-1-10 1V5Z' },
  { id: 'contact', label: 'Contact', labelPt: 'Contato', labelEs: 'Contacto', icon: 'M3 5h18v14H3V5Zm0 1 9 7 9-7' },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <div class="header-location" aria-label="Current section" data-i18n-aria-label-en="Current section" data-i18n-aria-label-pt="Seção atual" data-i18n-aria-label-es="Sección actual">
      <span class="header-location__prompt" aria-hidden="true">~/</span>
      <a href={`${withBase('/')}#home`}>portfolio</a>
      <span class="header-location__separator" aria-hidden="true">/</span>
      <span data-current-section data-i18n={`nav.${active ?? 'home'}`}>{active ?? 'Home'}</span>
    </div>
    <div class="header-tools">
      <div class="language-switch" role="group" aria-label="Language" data-i18n-aria-label-en="Language" data-i18n-aria-label-pt="Idioma" data-i18n-aria-label-es="Idioma">
        <button class="language-button" type="button" data-language="pt" aria-pressed="false" aria-label="Português" title="Português" lang="pt-BR"><LanguageFlag country="br" /></button>
        <button class="language-button" type="button" data-language="en" aria-pressed="false" aria-label="English" title="English" lang="en"><LanguageFlag country="us" /></button>
        <button class="language-button" type="button" data-language="es" aria-pressed="false" aria-label="Español" title="Español" lang="es"><LanguageFlag country="es" /></button>
      </div>
      <span class="header-tools__divider" aria-hidden="true"></span>
      <ThemeToggle />
    </div>
  </div>
</header>

<nav class="sidebar" id="primary-navigation" aria-label="Main navigation" data-i18n-aria-label-en="Main navigation" data-i18n-aria-label-pt="Navegação principal" data-i18n-aria-label-es="Navegación principal">
  <div class="sidebar-nav">
    {sections.map(({ id, label, labelPt, labelEs, icon }) => (
      <a class:list={['sidebar-link', { 'is-active': active === id }]} href={active === 'home' ? `#${id}` : `${withBase('/')}#${id}`} data-section-link={id} aria-current={active === id ? 'location' : undefined} aria-label={label} data-i18n-aria-label-en={label} data-i18n-aria-label-pt={labelPt} data-i18n-aria-label-es={labelEs}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon} /></svg>
        <span class="sidebar-link__label" data-i18n={`nav.${id}`} aria-hidden="true">{label}</span>
      </a>
    ))}
  </div>
</nav>

<script>
  import { initI18n } from '../../scripts/i18n';
  import { initNavigation } from '../../scripts/navigation';

  initI18n();
  initNavigation();
</script>

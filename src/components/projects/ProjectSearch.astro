---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const unique = (values: string[]) => [...new Set(values)].sort((a, b) => b.localeCompare(a));
const origins = unique(projects.map(({ data }) => data.origin));
const periods = unique(projects.map(({ data }) => data.period));
const disciplines = unique(projects.flatMap(({ data }) => data.disciplineTags));
const technologies = unique(projects.flatMap(({ data }) => data.technologyTags));
const groups = [
  { id: 'origin', label: 'Origin', labelPt: 'Origem', labelEs: 'Origen', values: origins, className: 'filter-chip--origin' },
  { id: 'period', label: 'Period', labelPt: 'Período', labelEs: 'Período', values: periods, className: 'filter-chip--period' },
  { id: 'discipline', label: 'Discipline', labelPt: 'Disciplina', labelEs: 'Disciplina', values: disciplines, className: 'filter-chip--discipline' },
  { id: 'technology', label: 'Technology', labelPt: 'Tecnologia', labelEs: 'Tecnología', values: technologies, className: 'filter-chip--technology' },
];
---

<section class="project-search" aria-label="Search and filter projects" data-i18n-aria-label-en="Search and filter projects" data-i18n-aria-label-pt="Buscar e filtrar projetos" data-i18n-aria-label-es="Buscar y filtrar proyectos" data-project-search>
  <label class="search-field">
    <span class="sr-only" data-i18n-en="Search projects" data-i18n-pt="Buscar projetos" data-i18n-es="Buscar proyectos">Search projects</span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="10.7" cy="10.7" r="6.7" fill="none" stroke="currentColor" stroke-width="1.8" />
      <path d="m16 16 4.2 4.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    <input type="search" placeholder="Search by project name or #tag" data-i18n-placeholder-en="Search by project name or #tag" data-i18n-placeholder-pt="Busque pelo nome do projeto ou #tag" data-i18n-placeholder-es="Busca por nombre del proyecto o #etiqueta" autocomplete="off" data-project-query />
    <kbd>/</kbd>
  </label>

  <details class="filter-panel">
    <summary>
      <span data-i18n-en="Filter by tags" data-i18n-pt="Filtrar por tags" data-i18n-es="Filtrar por etiquetas">Filter by tags</span>
      <span class="filter-count" data-filter-count hidden>0</span>
      <span class="filter-panel__chevron" aria-hidden="true">⌄</span>
    </summary>
    <div class="filter-panel__content">
      {
        groups.map((group) => (
          <fieldset class="filter-group" data-filter-group={group.id}>
            <legend data-i18n-en={group.label} data-i18n-pt={group.labelPt} data-i18n-es={group.labelEs}>{group.label}</legend>
            <div class="filter-group__options">
              {group.values.map((value) => (
                <button
                  class:list={['filter-chip', group.className]}
                  type="button"
                  data-filter-value={value}
                  aria-pressed="false"
                >
                  #{value}
                </button>
              ))}
            </div>
          </fieldset>
        ))
      }
      <button class="clear-filters" type="button" data-clear-filters disabled data-i18n-en="Clear filters" data-i18n-pt="Limpar filtros" data-i18n-es="Borrar filtros">Clear filters</button>
    </div>
  </details>

  <p class="search-status" aria-live="polite" data-search-status data-i18n-en={`Showing all ${projects.length} projects.`} data-i18n-pt={`Exibindo todos os ${projects.length} projetos.`} data-i18n-es={`Mostrando los ${projects.length} proyectos.`}>
    Showing all {projects.length} projects.
  </p>
</section>

<script>
  import { initProjectSearch } from '../../scripts/project-search';

  initProjectSearch();
</script>

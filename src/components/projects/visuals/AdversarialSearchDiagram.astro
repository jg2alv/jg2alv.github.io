---
const cellSize = 18;
// Legal alternating drops, listed from the first move to the tenth.
const moves = [3, 2, 3, 4, 2, 4, 1, 3, 0, 1];
const heights = Array<number>(7).fill(0);
const pieces = moves.map((column, index) => ({
  column,
  row: 5 - heights[column]++,
  firstPlayer: index % 2 === 0,
}));
---

<svg class="project-diagram" viewBox="0 0 360 210" aria-hidden="true">
  <text class="project-diagram__label" x="24" y="25">CONNECT FOUR</text>
  <text class="project-diagram__caption" x="336" y="25" text-anchor="end">schematic search</text>

  <rect x="24" y="45" width="126" height="108" rx="4" fill="var(--discipline-soft)" stroke="var(--discipline)" stroke-width="1.2" />
  {Array.from({ length: 42 }, (_, index) => (
    <circle cx={33 + (index % 7) * cellSize} cy={54 + Math.floor(index / 7) * cellSize} r="6.3" fill="var(--surface)" stroke="var(--border)" stroke-width="0.7" />
  ))}
  {pieces.map(({ column, row, firstPlayer }) => (
    <circle cx={33 + column * cellSize} cy={54 + row * cellSize} r="6.3" fill={firstPlayer ? 'var(--accent)' : 'var(--technology)'} stroke={firstPlayer ? 'var(--accent)' : 'var(--technology)'} stroke-width="0.7" />
  ))}
  <text class="project-diagram__caption" x="87" y="170" text-anchor="middle">6 × 7 board</text>

  <path d="m258 69-39 22m39-22 39 22M219 109l-22 22m22-22 22 22M297 109l-22 22" fill="none" stroke="var(--discipline)" stroke-width="1.2" stroke-linecap="round" />
  <path d="m297 109 22 22" fill="none" stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="3 3" />
  <rect x="239" y="49" width="38" height="21" rx="4" fill="var(--accent-soft)" stroke="var(--accent)" />
  <text x="258" y="63" text-anchor="middle" font-size="9" fill="var(--accent)">MAX</text>
  {[219, 297].map((x) => (
    <g>
      <rect x={x - 19} y="90" width="38" height="20" rx="4" fill="var(--discipline-soft)" stroke="var(--discipline)" />
      <text x={x} y="103.5" text-anchor="middle" font-size="9" fill="var(--foreground)">MIN</text>
    </g>
  ))}
  {[197, 241, 275].map((x) => (
    <rect x={x - 8} y="131" width="16" height="14" rx="3" fill="var(--surface)" stroke="var(--discipline)" />
  ))}
  <rect x="311" y="131" width="16" height="14" rx="3" fill="var(--surface)" stroke="var(--muted)" stroke-dasharray="2 2" />
  <path d="m311 121 9-6m-5 11 9-6" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" />
  <text x="314" y="157" text-anchor="middle" font-size="8" fill="var(--accent)">pruned</text>
  <text class="project-diagram__caption" x="249" y="174" text-anchor="middle">depth 1 → 2 → …</text>

  <path d="M24 184h312" stroke="var(--border)" />
  <text class="project-diagram__caption" x="180" y="201" text-anchor="middle">Minimax · Alpha–Beta · time-bounded deepening</text>
</svg>

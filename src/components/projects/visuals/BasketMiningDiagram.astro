---
const baskets = [
  { label: 'I1', items: [1, 1, 0, 0] },
  { label: 'I2', items: [1, 1, 1, 0] },
  { label: 'I3', items: [0, 0, 1, 1] },
];
---

<svg class="project-diagram" viewBox="0 0 360 210" aria-hidden="true">
  <text class="project-diagram__label" x="24" y="25">BASKET PATTERNS</text>
  <text class="project-diagram__caption" x="336" y="25" text-anchor="end">illustrative</text>

  <text class="project-diagram__caption" x="24" y="47">invoice × item</text>
  {['A', 'B', 'C', 'D'].map((item, index) => (
    <text x={79 + index * 24} y="61" text-anchor="middle" font-size="10" fill="var(--foreground)">{item}</text>
  ))}

  {baskets.map((basket, row) => (
    <g>
      <text class="project-diagram__caption" x="28" y={84 + row * 24}>{basket.label}</text>
      {basket.items.map((present, column) => (
        <g>
          <rect x={69 + column * 24} y={70 + row * 24} width="20" height="20" rx="3" fill={present ? 'var(--accent-soft)' : 'var(--surface)'} stroke={present ? 'var(--accent)' : 'var(--border)'} stroke-width="1" />
          <text x={79 + column * 24} y={84 + row * 24} text-anchor="middle" font-size="11" fill={present ? 'var(--accent)' : 'var(--muted)'}>{present}</text>
        </g>
      ))}
    </g>
  ))}

  <path d="M174 100h17V77h16m-4-3 4 3-4 3" fill="none" stroke="var(--discipline)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
  <rect x="212" y="62" width="124" height="30" rx="4" fill="var(--discipline-soft)" stroke="var(--discipline)" stroke-width="1.1" />
  <text x="274" y="81" text-anchor="middle" font-size="11" fill="var(--discipline)">FP-Growth</text>
  <path d="M274 96v14m-4-4 4 4 4-4" fill="none" stroke="var(--technology)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
  <rect x="212" y="116" width="124" height="29" rx="4" fill="var(--technology-soft)" stroke="var(--technology)" stroke-width="1.1" />
  <text x="274" y="135" text-anchor="middle" font-size="12" fill="var(--technology)">A → B</text>

  <path d="M24 164h312" stroke="var(--border)" />
  <text class="project-diagram__caption" x="180" y="183" text-anchor="middle">binary baskets → association rules</text>
  <text class="project-diagram__caption" x="180" y="201" text-anchor="middle">toy transactions · association is not causation</text>
</svg>

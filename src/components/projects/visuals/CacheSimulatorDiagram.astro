---
const accesses = [
  { block: 'A', result: 'MISS', hit: false },
  { block: 'B', result: 'MISS', hit: false },
  { block: 'A', result: 'HIT', hit: true },
];
---

<svg class="project-diagram" viewBox="0 0 360 210" aria-hidden="true">
  <text class="project-diagram__label" x="24" y="25">CACHE TRACE</text>
  <text class="project-diagram__caption" x="336" y="25" text-anchor="end">2 lines · fully associative</text>

  {accesses.map((access, index) => (
    <g>
      <rect x={24 + index * 116} y="43" width="80" height="44" rx="6" fill={access.hit ? 'var(--technology-soft)' : 'var(--accent-soft)'} stroke={access.hit ? 'var(--technology)' : 'var(--accent)'} stroke-width="1.3" />
      <text x={64 + index * 116} y="72" text-anchor="middle" font-size="24" fill="var(--foreground)">{access.block}</text>
      <text x={64 + index * 116} y="103" text-anchor="middle" font-size="10" fill={access.hit ? 'var(--technology)' : 'var(--accent)'}>{access.result}</text>
    </g>
  ))}
  <path d="M104 65h36m-4-4 4 4-4 4M220 65h36m-4-4 4 4-4 4" fill="none" stroke="var(--muted)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />

  <path d="M24 116h312" stroke="var(--border)" />
  <text class="project-diagram__label" x="24" y="135">FINAL CACHE STATE</text>
  <rect x="24" y="146" width="140" height="28" rx="4" fill="var(--discipline-soft)" stroke="var(--discipline)" />
  <rect x="196" y="146" width="140" height="28" rx="4" fill="var(--discipline-soft)" stroke="var(--discipline)" />
  <text x="94" y="164" text-anchor="middle" font-size="11" fill="var(--foreground)">line 0: A</text>
  <text x="266" y="164" text-anchor="middle" font-size="11" fill="var(--foreground)">line 1: B</text>

  <text class="project-diagram__caption" x="180" y="199" text-anchor="middle">FIFO order: A → B · hits keep the order</text>
</svg>

---
const clusters = [
  {
    x: 92,
    y: 105,
    radius: 42,
    color: 'var(--accent)',
    fill: 'var(--accent-soft)',
    points: [[50, 105], [72, 80], [88, 131], [114, 96], [113, 126]],
  },
  {
    x: 180,
    y: 79,
    radius: 32,
    color: 'var(--discipline)',
    fill: 'var(--discipline-soft)',
    points: [[180, 47], [156, 68], [169, 99], [200, 94], [196, 61]],
  },
  {
    x: 271,
    y: 113,
    radius: 41,
    color: 'var(--technology)',
    fill: 'var(--technology-soft)',
    points: [[312, 113], [249, 93], [271, 82], [286, 135], [245, 132]],
  },
];
---

<svg class="project-diagram" viewBox="0 0 360 210" aria-hidden="true">
  <text class="project-diagram__label" x="24" y="25">COVERING CLUSTERS</text>
  <text class="project-diagram__caption" x="336" y="25" text-anchor="end">schematic</text>

  {clusters.map((cluster) => (
    <g>
      <circle cx={cluster.x} cy={cluster.y} r={cluster.radius} fill={cluster.fill} fill-opacity="0.6" stroke={cluster.color} stroke-width="1.1" stroke-dasharray="4 3" />
      {cluster.points.map(([x, y]) => (
        <circle cx={x} cy={y} r="3" fill={cluster.color} />
      ))}
    </g>
  ))}

  <path d="M50 105h42" fill="none" stroke="var(--accent)" stroke-width="1.1" />
  <text x="70" y="99" text-anchor="middle" font-size="10" fill="var(--accent)">r</text>

  {clusters.map((cluster) => (
    <path d={`M${cluster.x} ${cluster.y - 5}l5 5-5 5-5-5Z`} fill="var(--surface)" stroke={cluster.color} stroke-width="1.7" stroke-linejoin="round" />
  ))}

  <path d="M24 168h312" stroke="var(--border)" />
  <circle cx="33" cy="184" r="2.7" fill="var(--muted)" />
  <text class="project-diagram__caption" x="43" y="187">data</text>
  <path d="M106 179l5 5-5 5-5-5Z" fill="var(--surface)" stroke="var(--muted)" stroke-width="1.3" stroke-linejoin="round" />
  <text class="project-diagram__caption" x="117" y="187">center</text>
  <path d="M185 184h22" stroke="var(--muted)" stroke-width="1.1" stroke-dasharray="4 3" />
  <text class="project-diagram__caption" x="217" y="187">coverage radius</text>

  <text class="project-diagram__caption" x="180" y="204" text-anchor="middle">distance-based coverage · illustration</text>
</svg>

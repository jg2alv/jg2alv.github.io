---
const queues = [
  { priority: 2, count: 3, color: 'var(--accent)' },
  { priority: 1, count: 2, color: 'var(--discipline)' },
  { priority: 0, count: 3, color: 'var(--technology)' },
];
---

<svg class="project-diagram" viewBox="0 0 360 210" aria-hidden="true">
  <text class="project-diagram__label" x="24" y="27">CARE QUEUES</text>
  <text class="project-diagram__label" x="232" y="27">EVENT HEAP</text>

  {queues.map((queue, index) => (
    <g>
      <text x="25" y={66 + index * 28} font-size="10" fill={queue.color}>{queue.priority}</text>
      {Array.from({ length: queue.count }, (_, position) => (
        <rect x={44 + position * 18} y={55 + index * 28} width="13" height="14" rx="2" fill={queue.color} />
      ))}
      <path d={`M99 ${62 + index * 28}h10q8 0 8 ${index === 0 ? '8' : index === 2 ? '-8' : '0'}V90h16`} fill="none" stroke={queue.color} stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  ))}
  <path d="m129 86 4 4-4 4" fill="none" stroke="var(--muted)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />

  <rect x="139" y="57" width="62" height="66" rx="6" fill="var(--surface)" stroke="var(--border)" />
  <text class="project-diagram__label" x="170" y="76" text-anchor="middle">UNITS</text>
  <rect x="150" y="87" width="15" height="14" rx="2" fill="var(--accent)" />
  <rect x="175" y="87" width="15" height="14" rx="2" fill="none" stroke="var(--border)" />
  <text class="project-diagram__caption" x="170" y="115" text-anchor="middle">service</text>
  <path d="M205 90h17m-4-4 4 4-4 4" fill="none" stroke="var(--muted)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />

  <g fill="none" stroke="var(--border)" stroke-width="1.5">
    <path d="m268 73-17 23m34-23 17 23" />
  </g>
  <circle cx="277" cy="60" r="16" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.5" />
  <circle cx="243" cy="110" r="16" fill="var(--surface)" stroke="var(--discipline)" stroke-width="1.5" />
  <circle cx="311" cy="110" r="16" fill="var(--surface)" stroke="var(--technology)" stroke-width="1.5" />
  <g class="project-diagram__caption" text-anchor="middle">
    <text x="277" y="64">t1</text>
    <text x="243" y="114">t2</text>
    <text x="311" y="114">t3</text>
  </g>

  <text class="project-diagram__label" x="24" y="157">ARRIVAL</text>
  <text class="project-diagram__label" x="336" y="157" text-anchor="end">DISCHARGE</text>
  <path d="M24 174h312" stroke="var(--border)" stroke-width="1.5" />
  <path d="M128 174h79m-5-4 5 4-5 4" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  <g fill="var(--discipline)">
    <circle cx="50" cy="174" r="3" />
    <circle cx="128" cy="174" r="3" />
    <circle cx="218" cy="174" r="3" />
    <circle cx="310" cy="174" r="3" />
  </g>
  <text class="project-diagram__caption" x="180" y="200" text-anchor="middle">next event → advance clock</text>
</svg>

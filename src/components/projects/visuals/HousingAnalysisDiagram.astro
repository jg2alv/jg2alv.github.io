---
const points = [
  [65, 142], [76, 128], [86, 139], [98, 114], [109, 124],
  [118, 99], [130, 110], [142, 88], [154, 105], [162, 77],
  [174, 91], [185, 65], [196, 80],
];
---

<svg class="project-diagram" viewBox="0 0 360 210" aria-hidden="true">
  <text class="project-diagram__label" x="24" y="26">CALIFORNIA HOUSING</text>
  <text class="project-diagram__caption" x="336" y="26" text-anchor="end">1990 census</text>

  <path d="M48 55v105h162" fill="none" stroke="var(--border)" stroke-width="1.3" />
  <path d="M48 82h162M48 108h162M48 134h162" fill="none" stroke="var(--border)" stroke-dasharray="3 5" opacity="0.65" />
  <text class="project-diagram__caption" x="48" y="46">value</text>
  <text class="project-diagram__caption" x="210" y="174" text-anchor="end">income</text>
  {points.map(([x, y], index) => (
    <circle cx={x} cy={y} r="3.5" fill={index % 3 === 0 ? 'var(--discipline)' : 'var(--accent)'} opacity="0.85" />
  ))}

  <path d="m250 83 32-25 32 25M258 78v43h48V78" fill="none" stroke="var(--discipline)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  <rect x="276" y="99" width="12" height="22" rx="1" fill="var(--discipline-soft)" stroke="var(--discipline)" />
  <rect x="266" y="84" width="9" height="9" rx="1" fill="var(--accent-soft)" stroke="var(--accent)" />
  <rect x="290" y="84" width="9" height="9" rx="1" fill="var(--accent-soft)" stroke="var(--accent)" />
  <text class="project-diagram__caption" x="282" y="146" text-anchor="middle">income · coast</text>
  <text class="project-diagram__caption" x="282" y="162" text-anchor="middle">age · location</text>

  <path d="M24 184h312" stroke="var(--border)" />
  <text class="project-diagram__caption" x="180" y="202" text-anchor="middle">schematic · not observed data</text>
</svg>

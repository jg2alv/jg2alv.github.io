---
const input = [1, 1, 0, 1];
const remainder = [0, 1, 1];
---

<svg class="project-diagram" viewBox="0 0 360 210" aria-hidden="true">
  <text class="project-diagram__label" x="24" y="27">SENSOR INPUT</text>
  <text class="project-diagram__label" x="336" y="27" text-anchor="end">REMAINDER</text>

  {input.map((bit, index) => (
    <g>
      <text class="project-diagram__caption" x="24" y={63 + index * 24}>{3 - index}</text>
      <rect x="42" y={49 + index * 24} width="24" height="19" rx="3" fill={bit ? 'var(--surface-soft)' : 'var(--surface)'} stroke="var(--discipline)" />
      <text x="54" y={62 + index * 24} text-anchor="middle" font-size="11" fill="var(--foreground)">{bit}</text>
      <path d={`M66 ${58.5 + index * 24}h70`} stroke="var(--discipline)" stroke-width="1.2" />
    </g>
  ))}

  <rect x="136" y="49" width="88" height="94" rx="8" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.5" />
  <text class="project-diagram__label" x="180" y="72" text-anchor="middle">MODULO</text>
  <text x="180" y="111" text-anchor="middle" font-size="29" fill="var(--accent)">% 5</text>
  <text class="project-diagram__caption" x="180" y="132" text-anchor="middle">13 mod 5 = 3</text>

  {remainder.map((bit, index) => (
    <g>
      <path d={`M224 ${68.5 + index * 28}h70`} stroke="var(--technology)" stroke-width="1.2" />
      <rect x="294" y={59 + index * 28} width="24" height="19" rx="3" fill={bit ? 'var(--technology-soft)' : 'var(--surface)'} stroke="var(--technology)" />
      <text x="306" y={72 + index * 28} text-anchor="middle" font-size="11" fill="var(--foreground)">{bit}</text>
      <text class="project-diagram__caption" x="328" y={73 + index * 28}>{2 - index}</text>
    </g>
  ))}

  <path d="M24 172h312" stroke="var(--border)" />
  <text class="project-diagram__caption" x="180" y="197" text-anchor="middle">4-bit input → 3-bit remainder</text>
</svg>

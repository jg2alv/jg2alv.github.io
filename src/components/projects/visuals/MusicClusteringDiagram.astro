---
const groups = [
  { color: 'var(--accent)', points: [[47, 115], [62, 103], [71, 124], [51, 135]] },
  { color: 'var(--discipline)', points: [[97, 108], [112, 99], [119, 119], [103, 131]] },
  { color: 'var(--technology)', points: [[141, 132], [156, 120], [166, 140], [147, 148]] },
];
---

<svg class="project-diagram" viewBox="0 0 360 210" aria-hidden="true">
  <text class="project-diagram__label" x="24" y="25">MUSIC PROFILES</text>
  <text class="project-diagram__caption" x="336" y="25" text-anchor="end">schematic</text>

  <rect x="24" y="45" width="88" height="28" rx="4" fill="var(--surface)" stroke="var(--border)" />
  <text x="68" y="63" text-anchor="middle" font-size="9" fill="var(--foreground)">StandardScaler</text>
  <path d="M116 59h14m-4-3 4 3-4 3" fill="none" stroke="var(--muted)" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" />
  <rect x="134" y="45" width="50" height="28" rx="4" fill="var(--discipline-soft)" stroke="var(--discipline)" stroke-width="1.1" />
  <text x="159" y="63" text-anchor="middle" font-size="10" fill="var(--discipline)">PCA</text>
  <path d="M188 59h14m-4-3 4 3-4 3" fill="none" stroke="var(--muted)" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" />
  <rect x="206" y="45" width="130" height="28" rx="4" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.1" />
  <text x="271" y="63" text-anchor="middle" font-size="10" fill="var(--accent)">MiniBatchKMeans</text>

  <path d="M30 92v62h151" fill="none" stroke="var(--border)" stroke-width="1" />
  {groups.map((group) => (
    <g>
      {group.points.map(([x, y]) => (
        <circle cx={x} cy={y} r="3.3" fill={group.color} />
      ))}
    </g>
  ))}

  <path d="M268 89l36 36-36 36-36-36Z" fill="none" stroke="var(--border)" stroke-width="1" />
  <path d="M268 107l18 18-18 18-18-18Z" fill="none" stroke="var(--border)" stroke-width="1" />
  <path d="M268 89v72m-36-36h72" fill="none" stroke="var(--border)" stroke-width="1" />
  <path d="M268 98l27 27-27 14-14-14Z" fill="var(--accent-soft)" fill-opacity="0.65" stroke="var(--accent)" stroke-width="1.4" stroke-linejoin="round" />
  <path d="M268 113l15 12-15 28-27-28Z" fill="var(--technology-soft)" fill-opacity="0.45" stroke="var(--technology)" stroke-width="1.3" stroke-linejoin="round" />

  <text class="project-diagram__caption" x="106" y="172" text-anchor="middle">exploratory groups</text>
  <text class="project-diagram__caption" x="268" y="172" text-anchor="middle">feature profiles</text>
  <path d="M24 183h312" stroke="var(--border)" />
  <text class="project-diagram__caption" x="180" y="201" text-anchor="middle">illustrative points and profiles · not observed data</text>
</svg>

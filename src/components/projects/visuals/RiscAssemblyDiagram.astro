---
const values = [2, 3, 4];
---

<svg class="project-diagram" viewBox="0 0 360 210" aria-hidden="true">
  <text class="project-diagram__label" x="24" y="27">ARRAY CHECK</text>
  <text class="project-diagram__label" x="336" y="27" text-anchor="end">a0</text>

  {values.map((value, index) => (
    <g>
      <rect x={24 + index * 68} y="43" width="40" height="34" rx="4" fill="var(--surface-soft)" stroke="var(--discipline)" />
      <text class="project-diagram__node-label" x={44 + index * 68} y="65" text-anchor="middle">{value}</text>
      {index < values.length - 1 && (
        <text x={78 + index * 68} y="65" text-anchor="middle" font-size="15" fill="var(--discipline)">&lt;</text>
      )}
    </g>
  ))}

  <path d="M210 60h48m-5-4 5 4-5 4" fill="none" stroke="var(--discipline)" stroke-width="1.3" />
  <rect x="272" y="43" width="64" height="34" rx="4" fill="var(--accent-soft)" stroke="var(--accent)" />
  <text class="project-diagram__rank" x="304" y="65" text-anchor="middle">1</text>
  <text class="project-diagram__caption" x="180" y="96" text-anchor="middle">Strictly increasing → true</text>

  <path d="M24 111h312" stroke="var(--border)" />
  <text class="project-diagram__label" x="24" y="135">NESTED CALLS</text>
  <text class="project-diagram__caption" x="336" y="135" text-anchor="end">Total = 78</text>

  <rect x="24" y="148" width="90" height="28" rx="4" fill="var(--surface-soft)" stroke="var(--technology)" />
  <text x="69" y="166" text-anchor="middle" font-size="9" fill="var(--foreground)">inventory</text>
  <path d="M114 162h24m-4-3 4 3-4 3" fill="none" stroke="var(--technology)" stroke-width="1.2" />

  <rect x="138" y="148" width="80" height="28" rx="4" fill="var(--surface-soft)" stroke="var(--technology)" />
  <text x="178" y="166" text-anchor="middle" font-size="9" fill="var(--foreground)">adjust</text>
  <path d="M218 162h24m-4-3 4 3-4 3" fill="none" stroke="var(--technology)" stroke-width="1.2" />

  <rect x="242" y="148" width="94" height="28" rx="4" fill="var(--surface-soft)" stroke="var(--technology)" />
  <text x="289" y="166" text-anchor="middle" font-size="9" fill="var(--foreground)">apply</text>
  <path d="M289 176v11H69v-11m-3 4 3-4 3 4" fill="none" stroke="var(--border)" stroke-width="1.1" />
  <text class="project-diagram__caption" x="180" y="204" text-anchor="middle">Save ra → stack → restore ra</text>
</svg>

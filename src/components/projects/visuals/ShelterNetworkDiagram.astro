---
const shelters = [
  { x: 62, y: 109, label: 'A' },
  { x: 116, y: 81, label: '2' },
  { x: 180, y: 109, label: '3' },
  { x: 244, y: 81, label: '4' },
  { x: 298, y: 109, label: 'B' },
];
---

<svg class="project-diagram" viewBox="0 0 360 210" aria-hidden="true">
  <text class="project-diagram__label" x="24" y="25">SHELTER NETWORK</text>
  <text class="project-diagram__caption" x="336" y="25" text-anchor="end">BFS: A → B</text>

  {shelters.map((shelter, index) => (
    <circle
      cx={shelter.x}
      cy={shelter.y}
      r="36"
      fill={index === 2 ? 'var(--accent-soft)' : 'var(--discipline-soft)'}
      fill-opacity="0.65"
      stroke={index === 2 ? 'var(--accent)' : 'var(--discipline)'}
      stroke-width={index === 2 ? '1.8' : '1.1'}
    />
  ))}

  <path d="M62 109 116 81 180 109 244 81 298 109" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />

  {shelters.map((shelter, index) => (
    <g>
      <circle
        cx={shelter.x}
        cy={shelter.y}
        r="10"
        fill="var(--surface)"
        stroke={index === 2 ? 'var(--accent)' : 'var(--foreground)'}
        stroke-width={index === 2 ? '1.8' : '1.1'}
      />
      <text
        x={shelter.x}
        y={shelter.y + 3.8}
        text-anchor="middle"
        font-size="11"
        fill={index === 2 ? 'var(--accent)' : 'var(--foreground)'}
      >{shelter.label}</text>
    </g>
  ))}

  <path d="M180 145v7" fill="none" stroke="var(--accent)" stroke-width="1.2" />
  <text x="180" y="164" text-anchor="middle" font-size="9" fill="var(--accent)">an articulation point</text>

  <path d="M24 178h312" stroke="var(--border)" />
  <text class="project-diagram__caption" x="180" y="199" text-anchor="middle">overlapping shelters → shortest covered route</text>
</svg>

---
const accesses = [
  { operation: 'W', page: 'P1' },
  { operation: 'R', page: 'P2' },
  { operation: 'R', page: 'P3' },
];
---

<svg class="project-diagram" viewBox="0 0 360 210" aria-hidden="true">
  <text class="project-diagram__label" x="24" y="25">VIRTUAL MEMORY</text>
  <text class="project-diagram__caption" x="336" y="25" text-anchor="end">illustrative trace</text>

  <text class="project-diagram__label" x="24" y="47">ACCESSES</text>
  {accesses.map(({ operation, page }, index) => (
    <g>
      <rect x="24" y={56 + index * 27} width="71" height="21" rx="3" fill={index === 2 ? 'var(--accent-soft)' : 'var(--surface)'} stroke={index === 2 ? 'var(--accent)' : 'var(--border)'} />
      <text x="59.5" y={70 + index * 27} text-anchor="middle" font-size="10" fill={index === 2 ? 'var(--accent)' : 'var(--foreground)'}>{operation} · {page}</text>
    </g>
  ))}

  <text class="project-diagram__label" x="155" y="47">2 RAM FRAMES</text>
  <rect x="155" y="56" width="83" height="66" rx="5" fill="var(--surface)" stroke="var(--discipline)" stroke-width="1.2" />
  <path d="M155 89h83" stroke="var(--border)" />
  <text x="196.5" y="77" text-anchor="middle" font-size="10" fill="var(--discipline)">P1 · dirty</text>
  <text x="196.5" y="110" text-anchor="middle" font-size="10" fill="var(--foreground)">P2</text>
  <text class="project-diagram__caption" x="196.5" y="137" text-anchor="middle">before P3</text>

  <path d="M95 120h25q8 0 8-8V103q0-8 8-8h17m-4-4 4 4-4 4" fill="none" stroke="var(--accent)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
  <text x="119" y="139" text-anchor="middle" font-size="8" fill="var(--accent)">page fault</text>

  <rect x="282" y="56" width="54" height="47" rx="4" fill="var(--technology-soft)" stroke="var(--technology)" />
  <path d="M290 68h38m-38 8h38m-38 8h38" stroke="var(--technology)" stroke-width="1" opacity="0.55" />
  <text x="309" y="96" text-anchor="middle" font-size="8" fill="var(--technology)">DISK</text>
  <path d="M238 73h42m-4-4 4 4-4 4" fill="none" stroke="var(--technology)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
  <text class="project-diagram__caption" x="287" y="119" text-anchor="middle">dirty eviction:</text>
  <text x="287" y="132" text-anchor="middle" font-size="9" fill="var(--technology)">write-back</text>

  <text class="project-diagram__label" x="24" y="158">REPLACEMENT POLICIES</text>
  <text x="24" y="174" font-size="9.5" fill="var(--foreground)">Random · FIFO · LRU · Second Chance</text>
  <path d="M24 184h312" stroke="var(--border)" />
  <text class="project-diagram__caption" x="180" y="201" text-anchor="middle">Tables: dense · 2-level · 3-level · inverted</text>
</svg>

---
import Footer from '../components/layout/Footer.astro';
import InterferenceField from '../components/common/InterferenceField.astro';
import Header from '../components/layout/Header.astro';
import { site } from '../data/site';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/identity.css';
import { withBase } from '../utils/paths';
import { PREFERENCE_KEYS } from '../utils/preferences';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'projects';
}

const {
  title = `${site.name} — Project Portfolio`,
  description = site.description,
  active,
} = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8fa" data-theme-color />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    <script is:inline define:vars={{ preferenceKeys: PREFERENCE_KEYS }}>
      (() => {
        let savedTheme = null;
        let savedLanguage = null;
        try {
          savedTheme = sessionStorage.getItem(preferenceKeys.theme);
          savedLanguage = sessionStorage.getItem(preferenceKeys.language);
        } catch {
          // Follow the system when session storage is unavailable.
        }
        let prefersDark = false;
        try {
          prefersDark = typeof window.matchMedia === 'function' && window.matchMedia('(prefers-color-scheme: dark)').matches;
        } catch {
          // Browsers without media-query support use the light theme.
        }
        const theme = savedTheme === 'light' || savedTheme === 'dark'
          ? savedTheme
          : prefersDark ? 'dark' : 'light';
        const supported = ['pt', 'en', 'es'];
        const languages = navigator.languages?.length ? navigator.languages : [navigator.language ?? 'en'];
        const detected = Array.from(languages, (locale) => locale.trim().toLowerCase().split(/[-_]/)[0]).find((language) => supported.includes(language));
        const language = supported.includes(savedLanguage) ? savedLanguage : detected ?? 'en';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.documentElement.lang = language === 'pt' ? 'pt-BR' : language;
        const meta = document.querySelector('[data-theme-color]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#0a0a0a' : '#f7f8fa');
      })();
    </script>
  </head>
  <body data-active-page={active ?? 'other'}>
    <InterferenceField />
    <a class="skip-link" href="#main-content" data-i18n-en="Skip to content" data-i18n-pt="Pular para o conteúdo" data-i18n-es="Saltar al contenido">Skip to content</a>
    <Header active={active} />
    <div class="site-content">
      <slot />
      <Footer />
    </div>
  </body>
</html>

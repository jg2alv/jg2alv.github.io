---
import type { CollectionEntry } from 'astro:content';
import ProjectTags from '../components/common/ProjectTags.astro';
import ProjectVisual from '../components/projects/ProjectVisual.astro';
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/paths';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const context = data.origin === 'academic' ? 'Academic project' : 'Personal project';
const discipline = data.discipline ?? data.disciplineTags
  .map((tag) => tag.split('-').map((word) => `${word.charAt(0).toUpperCase()}${word.slice(1)}`).join(' '))
  .join(', ');
---

<BaseLayout title={`${data.title} — Project Portfolio`} description={data.summary} active="projects">
  <main id="main-content" class="project-detail page-shell">
    <article>
      <header class="project-detail__header">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href={withBase('/')}>Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={withBase('/projects/')}>Projects</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">{data.title}</li>
          </ol>
        </nav>

        <h1>{data.title}</h1>
        <p class="project-detail__summary">{data.summary}</p>

        <dl class="project-detail__meta">
          <div>
            <dt>Context</dt>
            <dd>{context}</dd>
          </div>
          <div>
            <dt>Period</dt>
            <dd>{data.period}</dd>
          </div>
          {discipline && (
            <div>
              <dt>Discipline</dt>
              <dd>{discipline}</dd>
            </div>
          )}
          {data.origin !== 'personal' && (
            <div class:list={{ 'project-detail__meta-wide': !discipline }}>
              <dt>Role</dt>
              <dd>{data.role}</dd>
            </div>
          )}
        </dl>

        <ProjectTags
          origin={data.origin}
          period={data.period}
          disciplineTags={data.disciplineTags}
          technologyTags={data.technologyTags}
        />

        <a class="repository-button" href={data.repository} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.39.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
          </svg>
          View repository
          <span aria-hidden="true">↗</span>
        </a>
      </header>

      <div class="project-detail__visual">
        <ProjectVisual variant={data.visual} />
      </div>

      <div class="project-detail__body prose">
        <slot />
      </div>

      <div class="project-detail__back">
        <a class="back-link" href={withBase('/projects/')}><span aria-hidden="true">←</span> Back to all projects</a>
      </div>
    </article>
  </main>
</BaseLayout>
